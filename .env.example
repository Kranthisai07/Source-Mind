# ─────────────────────────────────────────────────────────────
# SourceMind Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
#
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ── Database (PostgreSQL 16 + pgvector) ───────────────────────
DATABASE_URL=postgresql+asyncpg://sourcemind:sourcemind@localhost:5432/sourcemind
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Cache (Redis 7.2) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Graph DB (Neo4j 5) ────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/sourcemind_dev

# ── Message Bus (Redpanda / Kafka) ────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ── AI / ML APIs ──────────────────────────────────────────────
# OpenAI — for text-embedding-3-large (3072 dimensions)
OPENAI_API_KEY=

# Anthropic Claude — for fact extraction, summarization
ANTHROPIC_API_KEY=

# ── Authentication (Clerk) ────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
# Explicit local-only bypass. Set false outside local development.
AUTH_DEV_BYPASS_ENABLED=true
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# JSON array of exact frontend origins allowed by Clerk session-token azp.
CLERK_AUTHORIZED_PARTIES=[]
# Optional only when using a custom Clerk JWT template with an aud claim.
CLERK_AUDIENCE=

# ── Object Storage (AWS S3) ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=sourcemind-dev

# ── Observability ─────────────────────────────────────────────
# Sentry — required in production, optional in development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Feature Flags ─────────────────────────────────────────────
# Disable these to run without Neo4j or Kafka in development
FF_NEO4J_ATTRIBUTION=true
FF_KAFKA_EVENTS=true
FF_CONFLICT_DETECTION=true
URL_INGESTION_ENABLED=false
SLACK_MEMORY_COMMANDS_ENABLED=false
# JSON: {"T123":{"workspace_id":"uuid","allowed_channel_ids":["C123"],"users":{"U123":"uuid"}}}
SLACK_INSTALLATIONS={}

# ── Expensive-operation limits ────────────────────────────────
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_INGESTION_PER_MINUTE=10
RATE_LIMIT_ANALYTICS_PER_MINUTE=30
RATE_LIMIT_WORKSPACE_CREATE_PER_HOUR=5
RATE_LIMIT_CONNECTOR_SYNC_PER_HOUR=5
RATE_LIMIT_SLACK_PER_MINUTE=20

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
