# The dependency tree does not satisfy npm 7+ strict peer resolution: CRA 5
# pins TypeScript-adjacent peers that React 19 packages disagree with. The
# lockfile was produced under this setting, so `npm ci` must read it too —
# otherwise CI fails to install a tree that installs fine locally, and the two
# environments disagree for a reason that has nothing to do with the code.
#
# Here rather than as a CI flag on purpose: a flag only fixes the machine that
# passes it, and the next person running `npm ci` locally hits the same wall.
legacy-peer-deps=true
